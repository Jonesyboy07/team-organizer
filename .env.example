DISCORD_TOKEN="" # Insert your Discord bot token here
DISCORD_CLIENT_ID="" # Add your Discord application/client ID here
DISCORD_OAUTH_CLIENT_ID="" # Optional website override; falls back to DISCORD_CLIENT_ID when blank
DISCORD_OAUTH_CLIENT_SECRET="" # Discord OAuth secret for website login
DISCORD_OAUTH_REDIRECT_URI="" # Optional Discord OAuth callback override; defaults to WEBSITE_HOST/WEBSITE_PORT
PREFIX="!" # Prefix for text commands only (e.g. !update)
DONATION_LINK="" # Optional donation link, or leave blank
INVITE_LINK="" # Optional invite link override
OWNER_ID="" # Required for owner-only commands like /refresh_help_docs and !update
SUGGESTION_GUILD_ID="" # Central guild for game suggestions
SUGGESTION_CHANNEL_ID="" # Channel receiving game suggestions
SUGGESTION_PING_USER_ID="" # User pinged when a game is suggested
WEBSITE_HOST="127.0.0.1" # Flask website bind host
WEBSITE_PORT="9090" # Flask website bind port
WEBSITE_URL_SCHEME="http" # Optional website URL scheme for generated OAuth callback URLs
WEBSITE_SECRET_KEY="" # Session secret for the website